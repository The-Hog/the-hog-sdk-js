# @the-hog/sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: THE_HOG_
#
# Security environment variables:
THE_HOG_ACCESS_KEY=your_accesskey_here
THE_HOG_SECRET_KEY=your_secretkey_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
THE_HOG_DEBUG=true
